          "request": {
            "name": "1Password Create a Partner Billing Account",
            "description": {
              "content": "Creates a new third-party partner billing account for a customer through the partner billing service. Returns the activation token used to create a partner billing link for the customer to complete provisioning. Append the activation token to a 1Password partnership redemption link to create the customer's partner billing link.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "partners",
                "accounts"
              ],
