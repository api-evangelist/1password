{
  "opencollection": "1.0.0",
  "info": {
    "name": "1Password Connect Server Accounts Health API",
    "version": "1.8.1"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Health",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "1Password Check Server Status",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://localhost:8080/heartbeat"
          },
          "docs": "Returns a simple response to indicate that the Connect server is active and responding to requests. This endpoint does not require authentication."
        },
        {
          "info": {
            "name": "1Password Get Server Health",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://localhost:8080/health"
          },
          "docs": "Returns detailed information about the state of the Connect server and its service dependencies, including the 1Password service connectivity status."
        }
      ]
    }
  ],
  "bundled": true
}