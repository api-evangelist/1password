{
  "opencollection": "1.0.0",
  "info": {
    "name": "1Password Connect Server Accounts Metrics API",
    "version": "1.8.1"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Metrics",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "1Password Get Server Metrics",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://localhost:8080/metrics"
          },
          "docs": "Returns Prometheus-compatible metrics about the Connect server including request counts, latencies, and resource usage."
        }
      ]
    }
  ],
  "bundled": true
}