      "name": "Sign-In Attempts",
      "description": {
        "content": "Retrieve information about sign-in attempts to 1Password accounts, including the name and IP address of the user who attempted to sign in, when the attempt was made, and for failed attempts the cause of failure.",
        "type": "text/plain"
      },
